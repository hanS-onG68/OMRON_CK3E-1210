{
  "basic_info": {
    "param_type": "32位浮点数",
    "n_range": "设备通道号 1-18"
  },
  "instructions": [
    {
      "func_name": "测量值",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "0001+(n-1)*2H",
      "desc": ""
    },
    {
      "func_name": "传感器灵敏度",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "0202+(n-1)*20+2H",
      "desc": "每个通道的灵敏度，范围0-4.0"
    },
    {
      "func_name": "载荷值",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "04D6+(n-1)*20+2H",
      "desc": "载荷值写入范围1~999999"
    },
    {
      "func_name": "小数点位数",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "09A6+(n-1)*2H",
      "desc": "小数点输入范围0-5位"
    },
    {
      "func_name": "清零",
      "read_code": "",
      "write_code": "10H",
      "reg_addr": "0A36+(n-1)*2H",
      "desc": "单通道清零"
    },
    {
      "func_name": "撤销零点",
      "read_code": "",
      "write_code": "10H",
      "reg_addr": "0A7E+(n-1)*2H",
      "desc": "还原清零之前保存的值"
    },
    {
      "func_name": "采样速率",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "0B0EH",
      "desc": "采样速率10HZ~4800HZ"
    },
    {
      "func_name": "标定方式",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "0F42+(n-1)*2H",
      "desc": "1=砝码标定，2=灵敏度标定"
    },
    {
      "func_name": "通讯间隔延时",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "0106H",
      "desc": "每个通道发送数据之间的间隔时间，单位：位，范围0-250 ms"
    },
    {
      "func_name": "通道最大量程",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "095E+(n-1)*2H",
      "desc": "写入范围1~999999"
    },
    {
      "func_name": "零点标定MV值",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "07AA+(n-1)*2H",
      "desc": "记录测量零点数值"
    },
    {
      "func_name": "增益标定MV值",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "07F2+(n-1)*2H",
      "desc": "记录一定深度的测量数值"
    },
    {
      "func_name": "增益标定数值",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "083E+(n-1)*2H",
      "desc": "与零点比较的测量深度"
    },
    {
      "func_name": "通讯地址",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "0F34H",
      "desc": "通讯地址默认为01，若修改，请修改后的地址指令读取或写入信息"
    },
    {
      "func_name": "模拟量选择",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "0EC0H",
      "desc": {
        "0": "0V~5V",
        "1": "0V~10V",
        "2": "-5V~+5V",
        "3": "-10V~+10V",
        "4": "12mA±8mA",
        "5": "0mA~20mA",
        "6": "0mA~24mA",
        "7": "10mA±10mA",
        "8": "12mA±12mA",
        "9": "4mA-20mA"
      }
    },
    {
      "func_name": "客户端/服务端切换",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "0F26H",
      "desc": "客户端 1，服务端 2"
    },
    {
      "func_name": "设备IP",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": ["0F0AH", "0F0CH", "0F0EH"],
      "desc": "范围0-255，共4个地址组成一个ip地址，示例：192.169.1.3"
    },
    {
      "func_name": "远程IP",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": ["0F2AH", "0F2CH", "0F2EH"],
      "desc": "范围0-255，共4个地址组成一个ip地址，示例：192.169.1.3"
    },
    {
      "func_name": "网关",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": ["0F18H", "0F1AH", "0F1CH", "0F1EH"],
      "desc": "和IP地址组成规则一致"
    },
    {
      "func_name": "子网掩码",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": ["0F10H", "0F12H", "0F14H", "0F16H"],
      "desc": "和IP地址组成规则一致，默认255.255.255.0"
    },
    {
      "func_name": "本地通信端口",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "0F20H",
      "desc": "设备通信时使用的TCP端口，默认502"
    },
    {
      "func_name": "远程通信端口",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "0F24H",
      "desc": "设备作为客户端连接服务端的端口，默认502"
    },
    {
      "func_name": "矩阵标定参数",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "0F94+(n-1)*2H",
      "desc": "矩阵标定时通道号为当前矩阵位置，从左至右，从上到下"
    },
    {
      "func_name": "矩阵标定",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "1122H",
      "desc": "0关，1开"
    },
    {
      "func_name": "矩阵计算起始通道",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "1124H",
      "desc": ""
    },
    {
      "func_name": "矩阵计算结束通道",
      "read_code": "03H",
      "write_code": "10H",
      "reg_addr": "1126H",
      "desc": ""
    }
  ]
}
